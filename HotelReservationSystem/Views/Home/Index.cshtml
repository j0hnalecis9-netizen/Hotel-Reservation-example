@model IEnumerable<HotelClass>
@{
    ViewData["Title"] = "Book Your Stay";
}

<div class="text-center mb-4">
    <h1>Choose Your Perfect Hotel Class</h1>
    <p class="text-muted">Modern and responsive booking experience.</p>
</div>

<div class="row g-4">
@foreach (var item in Model)
{
    var room = item.Rooms.FirstOrDefault();
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
            <img src="@item.ImageUrl" class="card-img-top room-img" alt="@item.Name" />
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">@item.Name</h5>
                <p>@item.Description</p>
                <small><strong>Services:</strong> @item.AvailableServices</small>
                <small><strong>Special Offer:</strong> @item.SpecialOffers</small>
                <p class="mt-2 fw-bold">@item.BasePricePerNight.ToString("C") / night</p>
                <a class="btn btn-primary mt-auto" asp-controller="Reservations" asp-action="Create" asp-route-roomId="@(room?.Id ?? 0)">Reserve Now</a>
            </div>
        </div>
    </div>
}
</div>
